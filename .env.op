# Secrets live in 1Password. Only 1Password  references here — safe to sync/commit.
# Load with: op run --env-file=.env.op -- <command>
# 1Password item: Private / Knowledge Graph neo4j - env  (Secure Note)

NEO4J_URI=op://Private/Knowledge Graph neo4j - env/NEO4J_URI
NEO4J_USERNAME=op://Private/Knowledge Graph neo4j - env/NEO4J_USERNAME
NEO4J_PASSWORD=op://Private/Knowledge Graph neo4j - env/NEO4J_PASSWORD
NEO4J_DATABASE=op://Private/Knowledge Graph neo4j - env/NEO4J_DATABASE
GOOGLE_CREDENTIALS_FILE=op://Private/Knowledge Graph neo4j - env/GOOGLE_CREDENTIALS_FILE
GOOGLE_TOKEN_FILE=op://Private/Knowledge Graph neo4j - env/GOOGLE_TOKEN_FILE
LLM_PROVIDER=op://Private/Knowledge Graph neo4j - env/LLM_PROVIDER
OLLAMA_BASE_URL=op://Private/Knowledge Graph neo4j - env/OLLAMA_BASE_URL
OLLAMA_MODEL=op://Private/Knowledge Graph neo4j - env/OLLAMA_MODEL
ANTHROPIC_API_KEY=op://Private/Knowledge Graph neo4j - env/ANTHROPIC_API_KEY
CLAUDE_MODEL=op://Private/Knowledge Graph neo4j - env/CLAUDE_MODEL
CLAUDE_MAX_TOKENS=op://Private/Knowledge Graph neo4j - env/CLAUDE_MAX_TOKENS
CLAUDE_REQUESTS_PER_MINUTE=op://Private/Knowledge Graph neo4j - env/CLAUDE_REQUESTS_PER_MINUTE
BATCH_SIZE=op://Private/Knowledge Graph neo4j - env/BATCH_SIZE
